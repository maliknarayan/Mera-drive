# ---------------------------------------------------------------------------
# SangamDrive configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# development | production
SANGAM_ENV=development

# debug | info | warn | error
LOG_LEVEL=info

# --- Network ---------------------------------------------------------------

# Port the Go API listens on.
API_PORT=8080

# Public origin of the API. Used to build the OAuth redirect URL.
API_BASE_URL=http://localhost:8080

# Public origin of the web app. Users are redirected here after OAuth.
APP_BASE_URL=http://localhost:3000

# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000

# Set when the API sits behind a reverse proxy so client IPs are read from
# X-Forwarded-For. Leave false if the API is directly exposed.
TRUST_PROXY=false

# --- Google OAuth ----------------------------------------------------------
# Create these at https://console.cloud.google.com -> APIs & Services
# -> Credentials -> OAuth client ID -> Web application.
# Authorised redirect URI must be exactly: {API_BASE_URL}/api/v1/auth/google/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Secrets ---------------------------------------------------------------
# Both must be 32 random bytes, base64-encoded:  openssl rand -base64 32
# Rotating ENCRYPTION_KEY invalidates every stored refresh token.

ENCRYPTION_KEY=
SESSION_SECRET=

# --- Cookies ---------------------------------------------------------------

# Leave empty to scope cookies to the exact API host.
COOKIE_DOMAIN=

# Must be true in production (requires HTTPS).
COOKIE_SECURE=false

# Session lifetime.
SESSION_TTL=720h

# --- Persistence -----------------------------------------------------------

# Only driver currently implemented.
STORE_DRIVER=sqlite
SQLITE_PATH=./data/sangamdrive.db

# --- Limits ----------------------------------------------------------------

# Requests allowed per IP inside RATE_LIMIT_WINDOW.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1m

# Max concurrent Google API calls issued per user request fan-out.
DRIVE_CONCURRENCY=8

# Timeout for a single Google API call (uploads/downloads are exempt).
DRIVE_TIMEOUT=30s

# --- Web (build-time, consumed by Next.js) ---------------------------------

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
